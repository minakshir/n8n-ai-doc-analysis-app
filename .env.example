# Copy to .env. Generate the token with: python3 -c "import secrets; print(secrets.token_hex(32))"
SERVICE_TOKEN=
MAX_UPLOAD_MB=50
MAX_PDF_PAGES=300
RETENTION_DAYS=7
# dayfirst = 03/04/2025 is 3 April; monthfirst = 4 March. Only used when a column is ambiguous.
AMBIGUOUS_DATE_ORDER=dayfirst
# Knowledge base (RAG). The embedding model must be created in Ollama first (see README).
OLLAMA_URL=http://ollama:11434
EMBED_MODEL=nomic-embed-text:v1.5
